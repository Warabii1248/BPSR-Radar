<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>BpsrRadar.Capture</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
		<!-- Disable Control-flow Enforcement Technology, allowing old versions of Windows 10 and LTSC without Shadow Stack support to run this -->
		<CetCompat>false</CetCompat>
    </PropertyGroup>

	<ItemGroup>
      <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.0-rc.2.25502.107" />
      <PackageReference Include="PacketDotNet" Version="1.4.9-pre49" />
      <PackageReference Include="Serilog" Version="4.3.1-dev-02387" />
      <PackageReference Include="SharpPcap" Version="6.3.1" />
      <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    </ItemGroup>

</Project>
