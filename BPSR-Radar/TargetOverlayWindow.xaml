<Window x:Class="BpsrRadar.TargetOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPSR Radar Target"
        Width="240" Height="44"
        MinWidth="90" MinHeight="30"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Border x:Name="Frame" CornerRadius="7" MouseLeftButtonDown="Frame_MouseLeftButtonDown">
        <Grid>
            <TextBlock x:Name="TargetText" Text="—"
                       VerticalAlignment="Center"
                       Margin="10,0,16,0"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"/>
            <Thumb x:Name="ResizeThumb" Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   DragDelta="ResizeThumb_DragDelta" Cursor="SizeNWSE">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Data="M14,2 L14,14 L2,14 Z" Fill="#66FFFFFF" Margin="0,0,1,1"
                                  Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
