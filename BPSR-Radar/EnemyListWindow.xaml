<Window x:Class="BpsrRadar.EnemyListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPSR Radar Enemies"
        Width="300" Height="64"
        MinWidth="200" MinHeight="1"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#CFE8EA"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border x:Name="Frame" CornerRadius="7" BorderThickness="1"
            Background="#0A1418" BorderBrush="#3FA7AD">
        <Border.Resources>
            <!-- Keep small text readable over the game when the panel is transparent.
                 The text and its dark edge never inherit the background's alpha. -->
            <Style TargetType="TextBlock">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" Opacity="1"
                                          ShadowDepth="0" BlurRadius="2"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Border Padding="8,3,8,3" Background="Transparent"
                    BorderBrush="#403FA7AD" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="HeaderDetails"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <Grid Grid.Row="1" Margin="5,2,5,0">
                <DockPanel>
                    <!-- Rows past the display limit, as a count only. -->
                    <TextBlock x:Name="OverflowText" DockPanel.Dock="Bottom"
                               Margin="22,1,4,0" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="EnemyScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel x:Name="EnemyRows"/>
                    </ScrollViewer>
                </DockPanel>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="10"/>
            </Grid>
            <Thumb x:Name="ResizeThumb" Grid.Row="2" Width="10" Height="10"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   DragDelta="ResizeThumb_DragDelta" Cursor="SizeWE">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Data="M14,2 L14,14 L2,14 Z" Fill="#66FFFFFF" Margin="0,0,1,1"
                                  Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
