<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>BpsrRadar</RootNamespace>
    <AssemblyName>BPSR-Radar</AssemblyName>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CetCompat>false</CetCompat>
    <Version>0.1.4</Version>
    <InformationalVersion>0.1.4</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BPSR-Radar.Capture\BPSR-Radar.Capture.csproj" />
    <!-- Exe reference: copies BPSR-Radar.LockTarget.exe next to the app and
         into publish output -->
    <ProjectReference Include="..\BPSR-Radar.LockTarget\BPSR-Radar.LockTarget.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.33.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Data\MonsterTable.json" Link="Data\MonsterTable.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Data\DummyTable.json" Link="Data\DummyTable.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Data\SceneTable.json" Link="Data\SceneTable.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
