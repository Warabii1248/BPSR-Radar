<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BPSR-Radar.LockTarget</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Carried so the helper and the app report the same build. It used to
         have no version at all, so its exe said 1.0.0 while the app said
         0.1.5: two numbers for one release. See the app's csproj for why the
         number is not written here. -->
    <Version Condition="'$(Version)' == ''">0.1.6.0</Version>

    <!-- Same reason as the app: the release should be a short list. -->
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Only English satellite resources: the other thirteen language
         folders come from dependencies, are never shown, and are most of
         what is left beside the executable. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
